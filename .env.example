NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Required for Administration > Users email invitations.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Server-only URL for the Python applicant-ranking service.
SCREENING_SERVICE_URL=http://127.0.0.1:8000
# Set the same secret on the private Python service in production.
SCREENING_SERVICE_API_KEY=
# Random server-only value used to hash public application rate-limit identifiers.
PUBLIC_APPLICATION_RATE_LIMIT_SALT=
# Server-only SMTP settings for recruitment-stage notification emails.
# Gmail: use smtp.gmail.com, port 465, secure true, and a Google App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-account@gmail.com
SMTP_PASSWORD=your-google-app-password
SMTP_FROM=Scim-Inventory <your-account@gmail.com>
